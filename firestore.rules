rules_version = '2';
// Regole della classifica di Snake. Vanno incollate in Firebase: console > Firestore Database > Regole > Pubblica.
// Ognuno può leggere la classifica, ma può scrivere solo il proprio punteggio, con valori plausibili.
service cloud.firestore {
  match /databases/{database}/documents {
    match /modes/{mode}/scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && mode in ['classic', 'timed', 'turbo', 'open']
        && request.resource.data.keys().hasOnly(['name', 'score', 'level', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 14
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 20000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 99
        && request.resource.data.at == request.time;
      // «Elimina i miei dati»: ognuno può cancellare solo il proprio punteggio
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Segnalazioni di nickname: chiunque abbia fatto l'accesso può crearne, nessuno può leggerle dall'app (le vedi tu nella console)
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['mode', 'uid', 'name', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.mode in ['classic', 'timed', 'turbo', 'open']
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128
        && request.resource.data.name is string && request.resource.data.name.size() <= 14
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
